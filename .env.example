# Copy to .env.local (never commit .env.local). Server-only: no NEXT_PUBLIC_ prefix.

# Supabase (Dashboard > Project Settings > API Keys). Run supabase/schema.sql in the SQL Editor first.
# Server-only names on purpose: the browser talks to /api/*, never to Supabase directly.
# Legacy keys work too: anon key as PUBLISHABLE, service_role key as SECRET.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Bypasses RLS. Used only to delete accounts. Never share or commit it.
SUPABASE_SECRET_KEY=

# Which AI each step uses. claude/openai are stubs. Keep mock locally so tests don't use the free quota.
#   text:  mock | gemini | claude | openai
#   image: mock | cloudflare | claude-svg | openai
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock

# Song recommendation search: mock | youtube.
# YOUTUBE_API_KEY is server-only: Google Cloud Console > APIs > YouTube Data API v3 > API key
# (restrict the key to YouTube Data API v3). Never share or commit it.
MUSIC_PROVIDER=mock
YOUTUBE_API_KEY=

# Gemini (text): free tier key from Google AI Studio, server-only. Each feature has its own model list
# (first, then fallback; mock after the last) so their free limits add up. Free tier: inputs may be used
# by Google to improve its products. Never share or commit the key.
GEMINI_API_KEY=
GEMINI_MODELS_SUMMARIZE=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_MODELS_CURATE=gemini-3.6-flash,gemini-3.1-flash-lite

# Cloudflare Workers AI (image): dash.cloudflare.com > Profile > API Tokens > "Workers AI" template.
# Server-only. Each model says its request format (json|multipart); the SVG placeholder after the last.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODELS=json:@cf/black-forest-labs/flux-1-schnell,multipart:@cf/black-forest-labs/flux-2-klein-4b

# Weather for each fragment: mock | kma. KMA = 기상청_단기예보 조회서비스 (data.go.kr), server-only
# general key ("Decoding" version). Keep mock locally. Coordinates are never stored.
WEATHER_PROVIDER=mock
KMA_SERVICE_KEY=

# Fill in only for the provider you pick.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
