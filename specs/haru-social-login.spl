@SCHEMA = "SPL-SYNTAX-v1.2"

@META {
  type = "개발지시"
  version = "1.0"
  reader = "코딩 에이전트 (Claude Code)"
  success = "로그인 화면에서 카카오·구글 버튼으로 가입·로그인하면 HttpOnly 세션 쿠키가 생기고, 처음이면 프로필 화면, 아니면 오늘 화면으로 간다. 이메일 로그인과 기존 계정은 그대로 동작하고, 소셜 계정도 마이페이지·탈퇴가 정상 동작한다"
  failure = "OAuth 콜백에서 남의 세션이 만들어지거나, 외부 주소로 리다이렉트할 수 있거나(open redirect), 이메일 계정이 소셜 로그인으로 남에게 넘어가거나, 소셜 계정이 탈퇴하지 못하거나, 기존 이메일 로그인·시험(npm test, security-smoke)이 깨진다"
  constraint = "웹프로그래밍 수업 팀 프로젝트. Supabase Auth 내장 OAuth 제공자(kakao, google)만 사용. 제공자 키는 Supabase 대시보드에만 두고 앱 코드·env에는 넣지 않는다"
}

@INTENT {
  CORE = "가입 장벽을 낮춘다: 카카오·구글 계정으로 버튼 한 번에 시작"
  MUST_PRESERVE [
    "이메일·비밀번호 가입·로그인·로그아웃·비밀번호 변경 동작"
    "브라우저는 Supabase를 직접 호출하지 않고 /api/* 만 쓴다 (OAuth 시작과 콜백도 서버 라우트)"
    "인증 쿠키 HttpOnly·Secure, CSRF 미들웨어(교차 출처 쓰기 403)"
    "탈퇴하면 모든 데이터와 그림 파일 삭제"
    "기존 시험 통과: npm test, scripts/security-smoke.sh 28항목"
  ]
  MUST_NOT [
    "제공자 client secret을 코드·저장소·env·로그에 두기 (Supabase 대시보드에만)"
    "콜백의 next·redirect 값으로 외부 도메인에 보내기 (같은 사이트 경로만)"
    "같은 이메일의 이메일 계정과 소셜 계정을 자동으로 합치기 (이메일 인증이 꺼져 있어 탈취 위험)"
    "OAuth state·PKCE 검증을 건너뛰기"
    "새 npm 패키지 추가 (@supabase/ssr의 OAuth 사용)"
  ]
}

DECISION_SCOPE {
  STRATEGY = USER
  REQUIREMENTS = USER
  STRUCTURE = BOTH
  EXPRESSION = AI
  VALIDATION = BOTH
  FINAL_APPROVAL = USER
}

@ENV {
  LANG = "TypeScript 5 (Node.js 24.14.1)"
  FRAMEWORK = "Next.js 15.5.28 App Router + React 19.1"
  RUNTIME = "Windows 11 개발 PC, 배포는 Vercel 서버리스 (Node.js)"
  TOOLCHAIN = "npm, tsc, eslint, node --test (Node 24 타입 제거), @supabase/supabase-js 2.118, @supabase/ssr 0.12"
  ROOT = "C:\Users\Jaehyeon\Desktop\26_2\웹프로그래밍\하루조각\haru-jogak"
  REPO = "GitHub hjaehyun/webTest (로컬 하루조각은 git 아님, 클론에 복사해 커밋)"
  BRANCH = "작업 후 main에 push"
  BUILD = "npm run build"
  RUN = "npm run dev (http://localhost:3000)"
  DB supabase {
    PROVIDER = "Supabase Auth + Postgres (RLS)"
    LOCATION = "Supabase 프로젝트 (env SUPABASE_URL)"
    SECRET_REF = "SUPABASE_SECRET_KEY"
    CONFIG_REF = "Supabase 대시보드 Authentication > Providers (Kakao, Google), URL Configuration (Site URL, Redirect URLs)"
  }
  INFRA {
    카카오 = "Kakao Developers 앱 (REST API 키, Client Secret, Redirect URI = Supabase 콜백)"
    구글 = "Google Cloud Console OAuth 클라이언트 (웹, Redirect URI = Supabase 콜백)"
    배포 = "Vercel 자동 배포 dayily-diary-seven.vercel.app"
  }
  CONSTRAINT [
    "OAuth 흐름은 PKCE: code verifier는 @supabase/ssr이 HttpOnly 쿠키에 보관"
    "앱의 콜백 주소: http://localhost:3000/api/auth/callback, https://dayily-diary-seven.vercel.app/api/auth/callback (Supabase Redirect URLs에 등록)"
    "카카오 이메일 동의는 비즈 앱이 아니면 받을 수 없을 수 있다: 이메일 없는 카카오 계정 허용 여부를 Supabase 설정과 함께 확인"
  ]
  FORBIDDEN_ENV [
    ".env.local 내용 출력·커밋"
    "제공자 콘솔·Supabase 대시보드를 에이전트가 직접 조작 (재현님이 안내에 따라 설정)"
    "force push"
  ]
}

@INPUT {
  REQUIRED {
    provider: ENUM[kakao, google]
  }
  OPTIONAL {
    next: TEXT
    oauth_code: TEXT
    oauth_error: TEXT
  }
}

@BRANCH {
  IF provider IN [kakao, google] { SET start = "signInWithOAuth(provider, redirectTo = 같은 출처 /api/auth/callback) → 제공자 주소로 302" }
  ELSE { SET start = "400" }

  IF callback HAS oauth_code AND exchangeCodeForSession 성공 { SET session = "HttpOnly 쿠키" }
  ELIF callback HAS oauth_error OR 교환 실패 { SET redirect = "/?error=oauth (로그인 화면에 '로그인하지 못했어요')" }

  IF session AND 프로필 없음 { SET redirect = "/profile" }
  ELIF session { SET redirect = "next가 '/'로 시작하는 같은 사이트 경로면 next, 아니면 /today" }

  IF 계정에 비밀번호 로그인 수단 없음 { SET account_kind = "social"  SET 탈퇴확인 = "'탈퇴' 입력"  SET 비밀번호변경 = "숨김" }
  ELSE { SET account_kind = "email" }

  FALLBACK { ASK "콜백 결과를 분류할 수 없다. 어떻게 처리할까?" OPTIONS["로그인 화면으로 오류 표시", "작업 중단"] }
}

@PIPELINE {
  PHASE 기준확인 {
    DESCRIPTION = "이 SPL 최신 리비전과 @supabase/ssr·Supabase Auth OAuth(PKCE) 문서를 확인한다. 특히 같은 이메일 자동 연결(identity linking) 동작이 이메일 인증 꺼짐 상태에서 어떻게 되는지, 끌 수 있는지 확인한다. 자동 연결을 막을 방법이 없으면 대안(예: 이메일 인증 켜기, 충돌 시 로그인 거부)을 재현님께 묻는다"
    TRACE = SUMMARY
    OUTPUT → 기준rev
    GATE = CONFIRM
  }
  PHASE 설정안내 {
    DESCRIPTION = "카카오·구글 콘솔 앱 등록과 Supabase 대시보드 설정(Provider 켜기, 키 입력, Site URL, Redirect URLs) 순서를 단계별로 안내한다. 재현님이 직접 설정한다"
    DEPENDS_ON = 기준확인
    TRACE = SUMMARY
    OUTPUT → 설정안내문
    GATE = CONFIRM
  }
  PHASE 순수로직 {
    DESCRIPTION = "next 경로 검사(같은 사이트 상대 경로만, //·\\·스킴·제어문자 거부), 제공자 이름 검사, 계정 종류 판별(identities에 email 제공자가 있는지)을 순수 함수로 두고 테스트한다"
    DEPENDS_ON = 설정안내
    TRACE = SUMMARY
    RUN npm test
    OUTPUT → 순수로직
    GATE = AUTO
  }
  PHASE 라우트 {
    DESCRIPTION = "GET /api/auth/oauth/[provider]: signInWithOAuth로 제공자 주소를 받아 302. GET /api/auth/callback: exchangeCodeForSession → 쿠키 → 프로필 유무로 /profile 또는 next·/today. 실패는 /?error=oauth. GET /api/me account에 kind(email|social)·provider 추가. DELETE /api/me: social은 confirm == '탈퇴', email은 기존 비밀번호 확인"
    DEPENDS_ON = 순수로직
    TRACE = SUMMARY
    OUTPUT → 라우트
    GATE = AUTO
  }
  PHASE 화면 {
    DESCRIPTION = "로그인 화면: 카카오(노란 버튼, 카카오 디자인 가이드)·Google(흰 버튼, Google 브랜드 가이드) 버튼, ?error=oauth면 오류 문구. 마이페이지: social이면 비밀번호 변경 숨김, 로그인 수단 표시, 탈퇴는 '탈퇴' 입력"
    DEPENDS_ON = 라우트
    TRACE = SUMMARY
    OUTPUT → 화면
    GATE = AUTO
  }
  PHASE 시험 {
    DESCRIPTION = "npm test, tsc, lint, build, security-smoke + 추가 항목(잘못된 제공자 400, 외부 next 무시, 코드 없는 콜백은 오류 화면), 이메일 로그인 회귀 e2e. 그다음 재현님 확인 후 실제 카카오·구글 로그인 1회씩(재현님 계정으로 재현님이 직접 진행, 에이전트는 비밀번호를 입력하지 않음)"
    DEPENDS_ON = 화면
    TRACE = FULL
    RUN npm test
    REVIEW 실제 카카오·구글 로그인 결과
    OUTPUT → 시험결과
    GATE = CONFIRM
  }
  PHASE 반영 {
    DESCRIPTION = "클론 pull → 변경 복사(.env.local 제외) → 커밋(Co-Authored-By 줄) → main에 push → 배포 smoke → 배포에서 소셜 로그인 확인(재현님)"
    DEPENDS_ON = 시험
    TRACE = SUMMARY
    OUTPUT → 배포
    GATE = CONFIRM
  }
  PHASE 보고 {
    DESCRIPTION = "기준 rev, 실행 명령, 실제 시험 결과를 report/YYYY-MM-DD_작업보고서.md와 대화로 보고하고 CLAUDE.md를 갱신한다"
    DEPENDS_ON = 반영
    TRACE = SUMMARY
    OUTPUT → 작업보고서
    GATE = AUTO
  }
}

@TEMPLATE {
  UNIT account_ext {
    STRUCT {
      kind: ENUM[email, social]
      provider: ENUM[email, kakao, google]
    }
    RULE = "GET /api/me account에 추가. 마이페이지가 비밀번호 변경·탈퇴 방식을 고르는 데 쓴다"
  }
  UNIT delete_request {
    STRUCT {
      password: TEXT
      confirm: TEXT
    }
    RULE = "email 계정은 password(기존), social 계정은 confirm == '탈퇴'. 맞지 않으면 403"
  }
  UNIT callback_redirect {
    STRUCT {
      next: TEXT
    }
    RULE = "'/'로 시작하고 '//'·'/\\'로 시작하지 않는 경로만 허용. 그 밖에는 /today. 프로필이 없으면 next와 상관없이 /profile"
  }
  MAP {
    [GET /api/me] → account_ext
    [DELETE /api/me] → delete_request
    [GET /api/auth/callback] → callback_redirect
  }
}

@STYLE {
  SCOPE[*] {
    "화면 문구는 하루조각 기존 말투: 짧은 해요체"
    DENY [ "OAuth 오류 원문(영어, 코드)을 화면에 그대로 노출" ]
  }
  SCOPE[버튼] {
    "카카오: '카카오로 시작하기', 노란 바탕 #FEE500, 검은 글자. Google: 'Google로 시작하기', 흰 바탕, 회색 테두리. 각 사 브랜드 가이드의 로고 사용 규칙을 따른다"
  }
}

@VALIDATE {
  RULE 리다이렉트안전 {
    SEVERITY = CRITICAL
    ASSERT 콜백 next가 'https://evil.example', '//evil.example', '/\\evil.example' 이면 /today 로 간다
    ON_FAIL → EMIT ERROR "open redirect"
  }
  RULE 제공자제한 {
    SEVERITY = CRITICAL
    ASSERT /api/auth/oauth/github, /api/auth/oauth/abc 는 400
    ON_FAIL → EMIT ERROR "허용하지 않은 제공자로 로그인 시작이 된다"
  }
  RULE 비밀값없음 {
    SEVERITY = CRITICAL
    ASSERT NOT 저장소 CONTAINS 카카오·구글 client secret AND NOT env 템플릿 CONTAINS 제공자 키 이름
    ON_FAIL → EMIT ERROR "제공자 비밀값이 앱에 들어왔다"
  }
  RULE 자동연결금지 {
    SEVERITY = CRITICAL
    ASSERT 같은 이메일로 이메일 계정과 소셜 계정을 만들면 서로 다른 user_id 이거나 소셜 로그인이 거부된다 (기준확인에서 정한 방식)
    ON_FAIL → EMIT ERROR "이메일 계정이 소셜 로그인으로 넘어갈 수 있다"
  }
  RULE 소셜탈퇴 {
    SEVERITY = CRITICAL
    ASSERT social 계정 DELETE /api/me {confirm: '탈퇴'} → 200, 데이터·그림 파일 삭제 AND confirm 없거나 다르면 403
    ON_FAIL → EMIT ERROR "소셜 계정이 탈퇴하지 못하거나 확인 없이 탈퇴된다"
  }
  RULE 기존시험 {
    SEVERITY = CRITICAL
    ASSERT 이메일 가입·로그인 e2e 통과 AND npm test 통과 AND security-smoke 통과 AND npm run build 성공
    ON_FAIL → EMIT ERROR "기존 로그인이 깨졌다"
  }
}
